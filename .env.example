# ============================================================================
# PreTrade — Environment Configuration Template
# Copy this file to `.env` and fill in your API keys:
#   cp .env.example .env
# Never commit your real `.env` or `config.local.json` file to version control.
# ============================================================================

# 1. Finnhub API Key (Required ONLY for live Finnhub WebSocket trade streaming)
#    Get a free API key at: https://finnhub.io/register
#    Note: Standard quotes, option chains, and historical charts use Yahoo Finance
#    (yfinance) and work out-of-the-box with NO API key required.
FINNHUB_API_KEY=

# 2. Optional Fallback / Supplemental Market Data Providers
#    Polygon.io (https://polygon.io/) — optional equity/options reference data
POLYGON_API_KEY=

#    Alpha Vantage (https://www.alphavantage.co/) — optional quote/FX fallback
ALPHA_VANTAGE_API_KEY=

#    FRED (https://fred.stlouisfed.org/docs/api/api_key.html) — optional Treasury rates
FRED_API_KEY=
